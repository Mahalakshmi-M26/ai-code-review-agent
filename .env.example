OPENAI_BASE_URL=https://openai.generative.engine.capgemini.com/v1
GEP_API_KEY=replace-with-your-key
MODEL_NAME=openai.gpt-5-mini
GITHUB_TOKEN=replace-with-your-github-token
GITHUB_OWNER=Mahalakshmi-M26
GITHUB_WEBHOOK_SECRET=replace-with-your-webhook-secret
ALLOWED_REPOSITORIES=*
ALLOW_DRAFT_REVIEWS=false
SCM_PROVIDER=mcp
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TOKEN=replace-with-github-mcp-token
GITHUB_MCP_TOOLS=get_pull_request_files,create_pull_request_review
GITHUB_MCP_TRANSPORT=stdio
GITHUB_MCP_COMMAND=npx
GITHUB_MCP_ARGS=-y @modelcontextprotocol/server-github
GITHUB_REST_FALLBACK=false
GITHUB_MCP_COMMAND=docker
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server
LOG_LEVEL=INFO
MAX_FILES=40
MAX_FILE_DIFF_CHARS=12000
MAX_REVIEW_INPUT_CHARS=100000
REVIEW_TIMEOUT_SECONDS=60
MOCK_EXTERNAL_SERVICES=true
